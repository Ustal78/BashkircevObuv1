<Page x:Class="BashkircevObuv.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="OrderPage"
      FontFamily="Calibri">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Оформление заказа"
                   FontSize="26"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">

            <TextBlock Text="Модель обуви"/>

            <ComboBox Name="ProductCombo"
                      Height="30"
                      Margin="0,5,0,10"
                      DisplayMemberPath="ProductName"
                      SelectionChanged="ProductCombo_SelectionChanged"/>

            <TextBlock Text="Размер"/>

            <ComboBox Name="SizeCombo"
                      Height="30"
                      Margin="0,5,0,10"
                      DisplayMemberPath="Sizes.SizeValue"/>

            <TextBlock Text="Количество пар"/>

            <TextBox Name="QuantityBox"
                     Height="30"
                     Margin="0,5,0,10"
                     Text="1"/>

            <Button Content="Добавить в заказ"
                    Height="35"
                    Width="180"
                    HorizontalAlignment="Left"
                    Click="AddButton_Click"/>
        </StackPanel>

        <DataGrid Name="CartGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Margin="0,0,0,15">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Модель"
                                    Binding="{Binding ProductName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Размер"
                                    Binding="{Binding Size}"
                                    Width="80"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="100"/>

                <DataGridTextColumn Header="Цена за пару"
                                    Binding="{Binding Price}"
                                    Width="120"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Total}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3">
            <TextBlock Name="TotalText"
                       Text="Итого: 0 руб."
                       FontSize="20"
                       Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Удалить выбранную позицию"
                        Width="220"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="RemoveButton_Click"/>

                <Button Content="Оформить заказ"
                        Width="160"
                        Height="35"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
