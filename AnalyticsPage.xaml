<Page x:Class="BashkircevObuv.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Аналитика"
      FontFamily="Calibri">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Аналитика продаж"
                   FontSize="28"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Дата начала"/>
                <DatePicker Name="StartDatePicker"
                            Width="160"
                            SelectedDateChanged="DatePicker_SelectedDateChanged"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Дата окончания"/>
                <DatePicker Name="EndDatePicker"
                            Width="160"
                            SelectedDateChanged="DatePicker_SelectedDateChanged"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,15">
            <TextBlock Name="OrdersCountText"
                       FontSize="18"
                       Text="Количество заказов: 0"/>

            <TextBlock Name="SalesTotalText"
                       FontSize="18"
                       Text="Сумма продаж: 0 руб."
                       Margin="0,5,0,0"/>

            <TextBlock Name="ErrorText"
                       Foreground="Red"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <DataGrid Name="TopGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  CanUserAddRows="False"/>

        <Button Grid.Row="4"
                Content="Экспорт в PDF"
                Width="150"
                Height="35"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Click="ExportButton_Click"/>
    </Grid>
</Page>
