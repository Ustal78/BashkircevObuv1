<Page x:Class="BashkircevObuv.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BashkircevObuv"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1200"
      Title="LoginPage" FontFamily="Calibri">
    <Grid>

        <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Вход в систему" FontSize="25" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин"/>

            <TextBox Name="LoginBox" Height="30" Margin="0,5,0,15"/>

            <Button Content="Войти" Height="30" Click="LoginButton_Click"/>

            <TextBlock Name="ErrorText" Foreground="Red" Margin="0,10,0,0"/>
            
            <Button Content="Войти как гость" Height="30" Margin="0,10,0,0" Click="GuestButton_Click"/>

        </StackPanel>

    </Grid>

</Page>
